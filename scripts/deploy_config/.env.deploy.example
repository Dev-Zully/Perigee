# Perigee per-contract deployment configuration (example).
#
# Copy to `.env.deploy` and fill in real values for your environment.
# Validate before deploy:
#   python3 scripts/deploy_config/validate_deployment_config.py --env-file .env.deploy
#
# All per-contract values are injected into the contract `initialize` calls
# at deployment time and exported as CONTRACT_* / *_<PARAM> variables for the
# core service (see core/src/config.rs and docs/DEPLOYMENT_CONFIG.md).

# ── Network / stage ──────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
APP_ENV=development
DEPLOYER_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Token (USDC-style anchor token) ─────────────────────────────────────────
CONTRACT_TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TOKEN_ADMIN=GCVXBQO5IXK35UKWJFO5TJ25Z2V6G4K7NSGWXLAO7XBFWYVYFWFDBQ6G
TOKEN_DECIMALS=7
TOKEN_INITIAL_SUPPLY=1000000000000
TOKEN_NAME="Perigee USDC"
TOKEN_SYMBOL=USDC

# ── Emergency Guard (multi-sig circuit breaker) ─────────────────────────────
CONTRACT_EMERGENCY_GUARD=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
GUARD_ADMINS=GCVXBQO5IXK35UKWJFO5TJ25Z2V6G4K7NSGWXLAO7XBFWYVYFWFDBQ6G,GCVBXQO5IXK35UKWJFO5TJ25Z2V6G4K7NSGWXLAO7XBFWYVYFWFDBQ6G
GUARD_THRESHOLD=2

# ── Oracle Aggregator ───────────────────────────────────────────────────────
CONTRACT_ORACLE_AGGREGATOR=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
ORACLE_MAX_STALENESS_SECONDS=900

# ── TWAP Oracle ─────────────────────────────────────────────────────────────
CONTRACT_TWAP_ORACLE=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TWAP_TOKEN_A=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TWAP_TOKEN_B=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TWAP_MIN_UPDATE_INTERVAL_SECONDS=60

# ── Staking Rewards ─────────────────────────────────────────────────────────
CONTRACT_STAKING_REWARDS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
STAKING_ADMIN=GCVXBQO5IXK35UKWJFO5TJ25Z2V6G4K7NSGWXLAO7XBFWYVYFWFDBQ6G

# ── Proxy (upgradeable contract proxy) ──────────────────────────────────────
CONTRACT_PROXY=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
PROXY_ADMIN=GCVXBQO5IXK35UKWJFO5TJ25Z2V6G4K7NSGWXLAO7XBFWYVYFWFDBQ6G
PROXY_INITIAL_IMPLEMENTATION=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC