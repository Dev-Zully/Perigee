#!/usr/bin/env sh
# .husky/commit-msg
# Validates the commit message against Conventional Commits via commitlint.
# The first argument ($1) is the path to the file containing the commit message.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "▶ [commit-msg] Validating commit message…"
"$REPO_ROOT/node_modules/.bin/commitlint" --edit "$1"

echo "✔ [commit-msg] Commit message is valid."
