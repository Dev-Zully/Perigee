    {
      "slug": "data-table",
      "title": "DataTable",
      "group": "data-display",
      "status": "stable",
      "issue": "WEB-33, WEB-34",
      "source": "components/ui/DataTable.tsx",
      "exports": [
        {
          "name": "DataTable",
          "kind": "function",
          "element": "div",
          "propsType": "DataTableProps<T>",
          "since": "0.1.0",
          "deprecated": null,
          "accessibilityNotes": 1,
          "examples": 1,
          "inheritedFrom": [],
          "props": [
            {
              "name": "columns",
              "type": "ColumnDef<T>[]",
              "default": null,
              "required": true,
              "description": "Column definitions."
            },
            {
              "name": "data",
              "type": "T[]",
              "default": null,
              "required": true,
              "description": "Row data."
            },
            {
              "name": "rowKey",
              "type": "(row: T, index: number) => string | number",
              "default": null,
              "required": false,
              "description": "Optional row key extractor. Defaults to the row index. Providing a stable key (e.g. a unique `id` field) avoids reconciliation issues when sorting / filtering."
            },
            {
              "name": "pageSize",
              "type": "number",
              "default": "0",
              "required": false,
              "description": "Number of rows per page. Pass 0 or undefined to disable pagination."
            },
            {
              "name": "filterKeys",
              "type": "(keyof T | string)[]",
              "default": null,
              "required": false,
              "description": "Keys of columns searched by the filter input. When omitted, all string/number cell values are included in the search."
            },
            {
              "name": "filterPlaceholder",
              "type": "string",
              "default": "'Filter…'",
              "required": false,
              "description": "Placeholder text for the filter input."
            },
            {
              "name": "emptyMessage",
              "type": "React.ReactNode",
              "default": "'No results found.'",
              "required": false,
              "description": "Message shown when the filtered result set is empty."
            },
            {
              "name": "title",
              "type": "React.ReactNode",
              "default": null,
              "required": false,
              "description": "Optional title rendered in the table header bar."
            },
            {
              "name": "subtitle",
              "type": "React.ReactNode",
              "default": null,
              "required": false,
              "description": "Optional subtitle rendered below the title."
            },
            {
              "name": "className",
              "type": "string",
              "default": null,
              "required": false,
              "description": "Additional className for the outermost container."
            },
            {
              "name": "'data-testid'",
              "type": "string",
              "default": null,
              "required": false,
              "description": "data-testid applied to the root element (WEB-34 compatibility)."
            }
          ],
          "types": [
            {
              "name": "ColumnDef",
              "values": null
            }
          ]
        }
      ]
    },
