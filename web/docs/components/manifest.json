    {
      "slug": "button",
      "title": "Button",
      "group": "actions",
      "status": "stable",
      "issue": "WEB-27 (#113)",
      "source": "components/ui/Button.tsx",
      "exports": [
        {
          "name": "Button",
          "kind": "forwardRef",
          "element": "button",
          "propsType": "ButtonProps",
          "since": "0.1.0",
          "deprecated": null,
          "accessibilityNotes": 1,
          "examples": 2,
          "inheritedFrom": [
            "React.ButtonHTMLAttributes<HTMLButtonElement>"
          ],
          "props": [
            {
              "name": "variant",
              "type": "\"default\" | \"destructive\" | \"outline\" | \"secondary\" | \"ghost\" | \"link\"",
              "default": "\"default\"",
              "required": false,
              "description": "Visual treatment. `\"default\"` is the cyan brand action; `\"destructive\"` is reserved for irreversible actions; `\"link\"` renders text-only styling."
            },
            {
              "name": "size",
              "type": "\"default\" | \"sm\" | \"lg\" | \"icon\"",
              "default": "\"default\"",
              "required": false,
              "description": "Control height and padding. `\"icon\"` is a square control for a single glyph."
            },
            {
              "name": "asChild",
              "type": "boolean",
              "default": "false",
              "required": false,
              "description": "Accepted for Radix-style API parity but **not implemented** yet: the component always renders a `<button>`. Kept optional so callers migrating from shadcn-based snippets do not fail type checking."
            }
          ],
          "types": []
        }
      ]
    },
