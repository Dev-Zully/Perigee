# ============================================================
#  Perigee — environment variables template
#  Copy this file to .env.local and fill in the values.
#  .env.local is git-ignored and must never be committed.
#
#  Last audited: WEB-30 (#116) + WEB-56 — all NEXT_PUBLIC_* env
#  vars consumed anywhere in web/ are documented here.
#  Audit sources: web/lib/api.ts, web/lib/config.ts,
#    web/lib/contracts.config.ts, web/lib/i18n.ts,
#    web/lib/vault-metadata.ts, web/components/SEO.tsx,
#    web/features/feature-flags/constants.ts
# ============================================================

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------
# Client-side base URL of the Perigee analyzer backend.
# Used in development; defaults to http://localhost:8080 if unset.
# In production the client calls /api and the server-side proxy
# (pages/api/[[...path]].ts) forwards requests to API_URL below.
# Required in development. Optional in production (proxy takes over).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side backend URL used by the Next.js API proxy route.
# Required in production (Vercel / Fly.io / etc.) so the proxy
# can forward /api/* requests to the Rust backend without CORS.
# Falls back to NEXT_PUBLIC_API_URL or http://localhost:8080.
API_URL=http://localhost:8080

# ------------------------------------------------------------
# Site origin
# Canonical base URL of this deployment (no trailing slash).
# Used to build absolute URLs for Open Graph / Twitter meta tags,
# canonical link elements, and JSON-LD structured data.
# Sources: web/lib/vault-metadata.ts, web/components/SEO.tsx
# Default: https://perigee.app  — override for custom domains.
# Optional.
# ------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://perigee.app

# ------------------------------------------------------------
# Stellar network
# Set to "local", "testnet", or "mainnet" / "public".
# Drives wallet-kit network selection and stage guards in
# web/lib/contracts.config.ts and NetworkStatusBanner.
# Default: local
# Required in production — set to "mainnet" on Vercel.
# ------------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=local

# ------------------------------------------------------------
# Feature flags
# Set to "true" to enable; any other value (or unset) disables.
# ------------------------------------------------------------
# Enable privacy-first analytics / Plausible telemetry.
# (web/components/Analytics.tsx, web/lib/telemetry.ts)
# Should be "true" only in production deployments.
# Default: false  Optional.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable verbose client-side debug logging (web/lib/logger.ts).
# Leave unset or "false" in production to suppress debug output.
# Default: false  Optional.
NEXT_PUBLIC_DEBUG_LOGGING=false

# Runtime feature flags — override the defaults in
# web/features/feature-flags/feature-flags.ts.
# The prefix NEXT_PUBLIC_FEATURE_FLAG_ is reserved by the
# FeatureFlagService (web/features/feature-flags/constants.ts).
# All flags default to false when the variable is unset.
# Optional.
# NEXT_PUBLIC_FEATURE_FLAG_newVaultUI=false
# NEXT_PUBLIC_FEATURE_FLAG_dashboardV2=false
# NEXT_PUBLIC_FEATURE_FLAG_experimentalCharts=false
# NEXT_PUBLIC_FEATURE_FLAG_notificationsV2=false

# ------------------------------------------------------------
# White-label / i18n overrides  (web/lib/i18n.ts)
# Set to a key that maps to messages/<label>.json to replace
# every user-facing English string with branded copy.
# Example: NEXT_PUBLIC_MANAGER_LABEL=acme → loads messages/acme.json
#          and merges its keys over the default en.json strings.
# Default: unset (uses standard Perigee strings).  Optional.
# ------------------------------------------------------------
# NEXT_PUBLIC_MANAGER_LABEL=

# ------------------------------------------------------------
# Contact / support links  (web/lib/config.ts)
# White-label managers: override these per deployment to
# rebrand every support touchpoint (error views, outage banners,
# RpcFallbackBanner). Blank or unset values fall back to
# Perigee defaults listed below.
# All optional.
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPPORT_URL=https://perigee.app/support
# NEXT_PUBLIC_SUPPORT_EMAIL=support@perigee.app
# NEXT_PUBLIC_DOCS_URL=https://perigee.app/docs
# NEXT_PUBLIC_STATUS_URL=https://status.perigee.app

# ============================================================
#  Contract IDs — one block per stage
#  Deploy scripts write the testnet block to .env.testnet.
#  CI/CD writes the mainnet block to Vercel env vars.
#  Sources: web/lib/contracts.config.ts
# ============================================================

# ------------------------------------------------------------
# LOCAL  (stellar-quickstart / local sandbox)
# Run scripts/start_local.sh to spin up a local node.
# These IDs are assigned by your local deploy; update freely.
# All optional for local dev — leave blank to skip strict mode.
# ------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
NEXT_PUBLIC_CONTRACT_TOKEN=
NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=

# ------------------------------------------------------------
# TESTNET  (Soroban Testnet — Test SDF Network ; September 2015)
# Written automatically by scripts/deploy_testnet.sh into
# .env.testnet. Source that file or copy the values here for
# local testnet development.
# ------------------------------------------------------------
# NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
# NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
# NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
# NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
# NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
# NEXT_PUBLIC_CONTRACT_TOKEN=
# NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
# NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
# NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=

# ------------------------------------------------------------
# MAINNET  (Stellar Public Network)
# Set these in your hosting provider (Vercel / Fly.io / etc.)
# as encrypted environment variables — never commit them.
# Required in production when using contractIds.strict().
# ------------------------------------------------------------
# NEXT_PUBLIC_CONTRACT_POLICY_VAULT=
# NEXT_PUBLIC_CONTRACT_STRATEGY_TRIGGER=
# NEXT_PUBLIC_CONTRACT_FEE_ACCRUAL=
# NEXT_PUBLIC_CONTRACT_EMERGENCY_GUARD=
# NEXT_PUBLIC_CONTRACT_LIQUIDITY_POOL=
# NEXT_PUBLIC_CONTRACT_TOKEN=
# NEXT_PUBLIC_CONTRACT_ORACLE_AGGREGATOR=
# NEXT_PUBLIC_CONTRACT_CROSS_CHAIN_VERIFIER=
# NEXT_PUBLIC_CONTRACT_HELLO_SOROBAN=
