{
  "name": "Perigee-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "node --test ./lib/**/*.test.cjs",
    "dev:proxy": "node ./dev-proxy/index.mjs",
    "dev:mock": "node ./dev-proxy/index.mjs --config dev.proxy.json",
    "dev:simulate": "node ./dev-proxy/index.mjs --config dev.proxy.json --simulate",
    "dev:fork": "node ./dev-proxy/index.mjs --config dev.proxy.json --fork",
    "dev:replay": "node ./dev-proxy/index.mjs --config dev.proxy.json --replay"
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test --reporter=github,html",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "cls": "^2.1.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.14.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.49.0",
    "@types/node": "25.0.10",
    "@types/node": "25.0.10",
    "@types/react": "19.2.9",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.11",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "msw": "^2.11.3",
    "dev-proxy": "^1.0.0"
  },
  "packageManager": "yarn@yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538"
}
