{
  "$comment": [
    "Rotation schedule for every long-lived secret Perigee holds.",
    "Validated by scripts/security/validate_secrets_rotation.py; see",
    "docs/SECRETS_ROTATION.md for the procedure each entry implies."
  ],
  "version": 1,
  "policies": {
    "critical": {
      "max_age_days": 90,
      "grace_period_days": 14,
      "require_dual_secret_window": true,
      "notify_on_rotation_days": [14, 7, 1]
    },
    "standard": {
      "max_age_days": 90,
      "grace_period_days": 7,
      "require_dual_secret_window": true,
      "notify_on_rotation_days": [7, 1]
    },
    "encryption_key": {
      "max_age_days": 365,
      "grace_period_days": 30,
      "require_dual_secret_window": true,
      "notify_on_rotation_days": [30, 7, 1]
    }
  },
  "secrets": [
    {
      "name": "DATABASE_URL",
      "policy": "critical",
      "owner": "platform",
      "source": "aws-secretsmanager",
      "consumers": ["core/src/main.rs"],
      "rotation_procedure": "rotate-db-credentials",
      "emergency_procedure": "break-glass-db-rotation",
      "audit": true
    },
    {
      "name": "REDIS_URL",
      "policy": "standard",
      "owner": "platform",
      "source": "aws-secretsmanager",
      "consumers": ["core/src/main.rs"],
      "rotation_procedure": "rotate-redis-credentials",
      "emergency_procedure": "break-glass-redis-rotation",
      "audit": true
    },
    {
      "name": "JWT_SIGNING_KEY",
      "policy": "encryption_key",
      "owner": "platform",
      "source": "aws-kms",
      "consumers": ["core/src/main.rs"],
      "rotation_procedure": "rotate-jwt-keyring",
      "emergency_procedure": "break-glass-jwt-rotation",
      "audit": true,
      "notes": "Dual-key window keeps in-flight sessions valid; see docs/SECRETS_ROTATION.md."
    },
    {
      "name": "VAULT_DEK_KEK",
      "policy": "encryption_key",
      "owner": "platform",
      "source": "aws-kms-hsm",
      "consumers": ["scripts/security/envelope_crypto.py"],
      "rotation_procedure": "rotate-kek-rewrap-deks",
      "emergency_procedure": "break-glass-kek-rotation",
      "audit": true,
      "notes": "Rotating the KEK re-wraps every DEK; it never re-encrypts record data."
    },
    {
      "name": "RPC_API_KEY",
      "policy": "standard",
      "owner": "platform",
      "source": "aws-secretsmanager",
      "consumers": ["core/src/main.rs", "web/.env.example"],
      "rotation_procedure": "rotate-rpc-key",
      "emergency_procedure": "break-glass-rpc-key",
      "audit": true
    },
    {
      "name": "CI_REGISTRY_TOKEN",
      "policy": "critical",
      "owner": "ci",
      "source": "github-actions-secrets",
      "consumers": [".github/workflows/security-scan.yml"],
      "rotation_procedure": "rotate-ci-registry-token",
      "emergency_procedure": "revoke-ci-registry-token",
      "audit": true
    },
    {
      "name": "SENTRY_DSN",
      "policy": "standard",
      "owner": "observability",
      "source": "vault",
      "consumers": ["web/pages/_app.tsx"],
      "rotation_procedure": "rotate-sentry-dsn",
      "emergency_procedure": "revoke-sentry-dsn",
      "audit": true
    }
  ]
}