# =============================================================================
#  Perigee API — End-to-End Test Environment
#  Copy this file to tests/e2e/.env and fill in the values.
#  .env is git-ignored and must never be committed.
#
#  These tests exercise the live API against Stellar testnet.
#  They require a running Perigee backend (cargo run -p Perigee-core).
# =============================================================================

# Base URL of the running Perigee API
API_BASE_URL=http://localhost:8080

# Stellar testnet RPC (used to verify ledger state in assertions)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Manager Stellar address used to provision vaults.
# Fund this address on testnet: https://laboratory.stellar.org/#account-creator?network=test
MANAGER_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# How many milliseconds to wait for an async reconcile job to complete
# before failing the test. Default: 30000 (30 s).
RECONCILE_TIMEOUT_MS=30000

# Tolerance for reconciliation delta checks (percent). Default: 10.
RECONCILE_TOLERANCE_PCT=10
